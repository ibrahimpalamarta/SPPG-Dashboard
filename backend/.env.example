# Copy to .env for local development. .env is gitignored — never commit real values.
# Staging/production values come from GitHub Environment variables + AWS Secrets
# Manager, not from this file. See README.md.

NODE_ENV=development
PORT=8080

# --- Database -----------------------------------------------------------
# Locally, set DATABASE_URL directly. In ECS the task definition injects the
# DB_* pieces instead (host/name from Terraform, credentials from Secrets
# Manager) and the app composes the URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sppg_dashboard
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=

# Read-only role for /api/public/* (SCRUM-13). Created by the
# 20260819000000_public_db_role migration, then given a password by
# `npm run grant:public-role`. Required in production; when unset the public
# routes fall back to the main connection and the app warns at boot.
# DATABASE_URL_PUBLIC=postgresql://sppg_public:...@localhost:5432/sppg_dashboard

# --- Uploads (S3 assets bucket) -----------------------------------------
# Bucket name comes from Terraform (module storage, output `bucket_name`).
# Credentials are never set here: locally the usual AWS_* chain, in ECS the
# task role. UPLOAD_MAX_BYTES caps a single upload — a menu workbook is a few
# hundred KB, so 10 MB is slack rather than a target.
S3_BUCKET=sppg-dashboard-staging-assets
AWS_REGION=ap-southeast-3
UPLOAD_MAX_BYTES=10485760

# --- Authentication (internal: password + session in Postgres) ----------
# 32 random bytes, base64: `openssl rand -base64 32`. SECRET. Encrypts TOTP
# secrets at rest and signs the MFA challenge token. Rotating it un-enrols
# every authenticator. In ECS this comes from Secrets Manager.
MFA_ENCRYPTION_KEY=
# Comma-separated roles that cannot use the app without MFA, e.g. SUPER_ADMIN.
MFA_REQUIRED_ROLES=
# Trusted proxy hops for X-Forwarded-For. 1 = ALB only. Set 2 when the admin
# frontend reaches this API through the ALB as well (it forwards the real client
# IP), otherwise all users share one per-IP login limit.
TRUST_PROXY_HOPS=1
# Idle timeout slides with use; the absolute cap does not.
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=168
# Per-account lockout, plus a per-IP limiter on /api/auth/login|mfa|reset.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_ENDPOINT_RATE_LIMIT_WINDOW_MS=900000
AUTH_ENDPOINT_RATE_LIMIT_MAX=20
# How long a set/reset-password link stays valid.
PASSWORD_RESET_TTL_MINUTES=60
# "Lupa kata sandi?" emails a reset link through SES. EMAIL_FROM is a verified
# SES identity; ADMIN_BASE_URL is the admin frontend's public URL incl. /admin.
# Either blank = nothing is sent. Local example: http://localhost:3000/admin
EMAIL_FROM=
ADMIN_BASE_URL=
# How long an invitation link (new account) stays valid.
INVITE_TTL_HOURS=72

# --- Rate limiting ------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=500

# The public dashboard (/api/public/*) has its own limiter: no token to verify
# and no DB write behind it, but also no caller identity to attribute abuse to,
# hence a shorter window.
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120

# --- CORS ---------------------------------------------------------------
# Comma-separated browser origins allowed to call this API cross-origin.
# Leave blank in staging/production: both frontends sit behind the same ALB,
# where /api/* is a listener rule rather than a separate origin, so calls are
# already same-origin. Blank means no CORS headers are sent at all.
# For local development, set it to wherever Next.js is running:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=

# --- Seed script only (never set these on the running service) ----------
# `npm run seed:superadmin` creates the first Super Admin. Leave the password
# blank to get a one-time set-password link printed instead (preferred in
# production: no password ever sits in a shell history or CI log). If you do
# set one: 12+ characters AND at least 3 of lowercase / uppercase / digit /
# symbol.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
