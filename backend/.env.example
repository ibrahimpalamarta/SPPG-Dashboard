# Copy to .env for local development. .env is gitignored — never commit real values.
# Staging/production values come from GitHub Environment variables + AWS Secrets
# Manager, not from this file. See README.md.

NODE_ENV=development
PORT=8080

# --- Database -----------------------------------------------------------
# Locally, set DATABASE_URL directly. In ECS the task definition injects the
# DB_* pieces instead (host/name from Terraform, credentials from Secrets
# Manager) and the app composes the URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sppg_dashboard
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=

# --- Auth0 (API / token verification) -----------------------------------
# None of these are secret. The API only ever verifies tokens; it holds no
# Auth0 credentials of its own.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.sppg-dashboard.example
AUTH0_ROLES_CLAIM=https://sppg-dashboard.example/roles

# --- Rate limiting ------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# --- Seed script only (never set these on the running service) ----------
# Machine-to-Machine application dedicated to seeding, authorised for the
# Management API with exactly these scopes and nothing more:
#   read:users  create:users  read:roles  create:role_members
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_CONNECTION=Username-Password-Authentication

SEED_SUPERADMIN_EMAIL=
# Leave blank to have a strong password generated and printed once.
# If you do set one: 12+ characters AND at least 3 of lowercase / uppercase /
# digit / symbol. Length alone is not enough — Auth0's default policy counts
# character classes, so "supersecret123oke" is rejected despite being 17 chars.
SEED_SUPERADMIN_PASSWORD=
