{
  "id": "sppg-dashboard-local",
  "name": "SPPG Dashboard — Local",
  "_postman_variable_scope": "environment",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true
    },
    {
      "key": "auth0_domain",
      "value": "your-tenant.us.auth0.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "auth0_connection",
      "value": "Username-Password-Authentication",
      "type": "default",
      "enabled": true
    },
    {
      "key": "auth0_audience",
      "value": "https://api.sppg-dashboard.example",
      "type": "default",
      "enabled": true
    },
    {
      "key": "auth0_roles_claim",
      "value": "https://sppg-dashboard.example/roles",
      "type": "default",
      "enabled": true
    },
    {
      "key": "auth0_client_id",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "auth0_client_secret",
      "value": "",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "username",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "password",
      "value": "",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "access_token",
      "value": "",
      "type": "secret",
      "enabled": true
    }
  ]
}
