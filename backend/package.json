{
  "name": "sppg-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:superadmin": "node --env-file=.env --import tsx scripts/seed-superadmin.ts",
    "seed:reference": "node --env-file=.env --import tsx scripts/seed-reference-data.ts",
    "grant:public-role": "node --env-file=.env --import tsx scripts/grant-public-role.ts",
    "pretest": "prisma generate",
    "test": "node --env-file=.env.test --import tsx --test src/auth/guard.test.ts src/lib/menu-workbook.test.ts src/auth/jwt.test.ts src/auth/user-sync.test.ts src/config/env.test.ts src/controllers/cms/cms.test.ts src/controllers/menu/menu-plan.test.ts src/controllers/upload/upload-batch.test.ts src/lib/scope.test.ts src/lib/serialize.test.ts src/lib/visibility.test.ts src/middleware/validate.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jose": "^5.9.6",
    "multer": "^2.2.0",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
