{
  "name": "sppg-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/src/server.js",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:superadmin": "node --env-file=.env --import tsx scripts/seed-superadmin.ts",
    "seed:reference": "node --env-file=.env --import tsx scripts/seed-reference-data.ts",
    "pretest": "prisma generate",
    "test": "node --env-file=.env.test --import tsx --test src/config/env.test.ts src/auth/jwt.test.ts src/auth/user-sync.test.ts src/auth/guard.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jose": "^5.9.6",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
