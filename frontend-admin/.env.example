# Auth0 "Regular Web Application" for this admin app (not the backend API).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
# Origin only: the SDK appends the /admin base path itself.
APP_BASE_URL=http://localhost:3000
# Must equal the backend's AUTH0_AUDIENCE so /api accepts the token.
AUTH0_AUDIENCE=https://api.sppg-dashboard.example

# Backend origin, called server-side only.
API_BASE_URL=http://localhost:8080
