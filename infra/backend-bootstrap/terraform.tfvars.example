# Copy this file to terraform.tfvars (gitignored) and fill in real values.
# terraform.tfvars is never committed — it holds the account-specific values
# this whole design exists to keep out of version control.

account_id  = "111111111111"
aws_region  = "ap-southeast-3"
project_name = "dashboard-sppg"

github_org  = "your-github-org-or-username"
github_repo = "dashboard_sppg"
