# Copy to terraform.tfvars (gitignored) for local runs.
# In CI, these are passed as `-var` flags sourced from GitHub Environment
# variables instead — this file is only a convenience for local apply.

account_id  = "111111111111"
github_org  = "your-github-org-or-username"
github_repo = "SPPG-Dashboard"

# Wajib: tidak punya default di variables.tf. Di CI nilainya datang dari
# GitHub Environment variables AUTH0_DOMAIN / AUTH0_AUDIENCE / AUTH0_ROLES_CLAIM.
auth0_domain      = "your-tenant-staging.au.auth0.com"
auth0_audience    = "https://api.sppg-dashboard.local"
auth0_roles_claim = "https://sppg-dashboard/roles"
