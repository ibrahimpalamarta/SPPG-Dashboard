# Copy to backend-staging.hcl (gitignored) for local runs, or pass the same
# key=value pairs as -backend-config flags directly (this is what CI does,
# building each value from GitHub Environment variables).
#
# terraform init -backend-config=backend-staging.hcl

bucket         = "sppg-dashboard-terraform-state-staging"
key            = "staging/terraform.tfstate"
region         = "ap-southeast-2"
dynamodb_table = "sppg-dashboard-terraform-lock-staging"
encrypt        = true
