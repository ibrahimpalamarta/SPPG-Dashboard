# Salin ke qa-audit/.env (gitignored). Semua opsional: tanpa file ini `npm run audit`
# tetap jalan dengan Postgres embedded dan password seed acak per run.

# Suite Playwright: smoke | full | uat
# QA_SUITE=smoke

# Pakai Postgres lokal sendiri alih-alih embedded (host harus localhost).
# User-nya perlu hak ALTER ROLE (untuk sppg_public).
# QA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sppg_qa

# Password akun seed QA. Kosong = acak per run (disarankan).
# QA_SEED_PASSWORD=

# Satu-satunya host non-localhost yang diizinkan guard (fase 5 / ZAP mingguan).
# QA_STAGING_URL=https://staging.example

# Lewati build backend & frontend-admin saat iterasi lokal (hasil build lama dipakai).
# QA_SKIP_BUILD=1

# Jalankan test @visual di laptop (baseline tetap hanya dari CI).
# RUN_VISUAL=1

# Rentang commit untuk gitleaks (default origin/develop..HEAD).
# QA_GIT_RANGE=origin/develop..HEAD

# 0 = laporan saja, exit code selalu 0.
# ENFORCE=1

# Analisis AI (saran, bukan gate) untuk `npm run ai-review`. Jangan commit kuncinya.
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
