{
  "name": "sppg-qa-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "audit": "tsx scripts/audit.ts",
    "stage:code": "tsx scripts/code-audit.ts",
    "stage:logic": "vitest run",
    "stage:env": "tsx scripts/env.ts up",
    "stage:e2e": "playwright test --list --reporter=json > reports/raw/playwright-list.json && playwright test",
    "env:down": "tsx scripts/env.ts down",
    "report": "tsx scripts/merge-report.ts",
    "ai-review": "tsx scripts/ai-review.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
